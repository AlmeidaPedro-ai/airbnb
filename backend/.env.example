# Copie para .env e ajuste. Em produção (Railway) use as variáveis do ambiente.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/airbnb
JWT_SECRET=troque-este-segredo
ENV=dev
TZ=America/Sao_Paulo

# Diretório do build do frontend a ser servido pela API (vazio = não servir).
# Na imagem Docker é definido como /app/static automaticamente.
FRONTEND_DIST=

# Popula o dataset de exemplo no start (idempotente). Use só na 1ª subida.
SEED_ON_START=false

# Nº de workers do gunicorn em produção (default 2).
WEB_CONCURRENCY=2
